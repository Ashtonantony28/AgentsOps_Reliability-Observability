# --- Postgres ---
POSTGRES_USER=agentops
POSTGRES_PASSWORD=agentops
POSTGRES_DB=agentops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Backend ---
APP_ENV=development
APP_SECRET=change-me-please-32-bytes-minimum-secret-key
JWT_SECRET=change-me-too-please-32-bytes-minimum-jwt-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=14
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# --- Optional integrations ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# --- Seed ---
SEED_ON_START=true
DEMO_EMAIL=demo@agentops.dev
DEMO_PASSWORD=Demo1234!
